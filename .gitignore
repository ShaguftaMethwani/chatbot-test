# ──────────────────────────────────────────────
# Mutual Fund FAQ Assistant — .gitignore
# ──────────────────────────────────────────────

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
venv/
.venv/
env/

# --- Environment / Secrets ---
.env
*.env
!.env.example

# --- ChromaDB Persistence (ephemeral on Railway — rebuilt on each start) ---
data/chroma_db/
backend/data/chroma_db/

# --- Raw Scraped Data ---
# Intentionally tracked in Git so Railway has fallback data on cold starts.
# The daily GitHub Actions workflow keeps these files up to date.
# Only ignore log files that may appear alongside the JSON.
backend/data/raw/*.log

# --- Frontend env files ---
# .env.local is for local dev overrides — never commit secrets.
stitch_hdfc_mutual_fund_assistant/.env.local
stitch_hdfc_mutual_fund_assistant/.env.*.local

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Testing ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- Misc ---
*.log
*.bak
*.tmp
